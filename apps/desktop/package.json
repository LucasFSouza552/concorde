{
  "name": "@concorde/desktop",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "main": "./out/main/index.js",
  "build": {
    "appId": "com.concorde.app",
    "productName": "Concorde",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/loopback",
        "to": "loopback"
      },
      {
        "from": "resources/concorde.ico",
        "to": "concorde.ico"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/concorde.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "LucasFSouza552",
      "repo": "concorde"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:online": "cross-env VITE_API_URL=https://concorde-cloud.lucasfelipe552.workers.dev electron-vite dev",
    "build": "tsc -b && electron-vite build && electron-builder --win",
    "dist": "pnpm build && electron-builder --win",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "dist:beta": "pnpm build && electron-builder --win --config electron-builder-beta.yml"
  },
  "dependencies": {
    "@concorde/shared": "workspace:*",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "axios": "^1.20.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
